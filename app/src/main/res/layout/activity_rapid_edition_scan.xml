<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rapidScanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/experimentalCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <io.asv.mtgocr.ocrreader.ExperimentalCardGuideView
        android:id="@+id/experimentalScanLiveGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <io.asv.mtgocr.ocrreader.CardCropAdjustView
        android:id="@+id/experimentalCropCorrection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="104dp"
        android:contentDescription="@string/edition_scan_crop_correction"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/bg_scan_debug_status"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/rapidScanTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rapid_scan_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hashScanOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <CheckBox
                android:id="@+id/hashScanAutoAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hash_scan_auto_add"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFFFFF" />
            <CheckBox
                android:id="@+id/hashScanBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hash_scan_border"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFFFFF" />
            <CheckBox
                android:id="@+id/hashScanLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hash_scan_language"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFFFFF" />
            <CheckBox
                android:id="@+id/hashScanOcr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hash_scan_ocr"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFFFFF" />
            <CheckBox
                android:id="@+id/hashScanSymbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hash_scan_symbol"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/experimentalScanInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/experimental_scan_align_card"
            android:textColor="#D6FF7F"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rapidScanEarlyResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_scan_debug_status"
            android:padding="9dp"
            android:textColor="?attr/colorSecondary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rapidScanSession"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/rapid_scan_session_empty"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:strokeColor="?attr/colorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rapidScanUndoLast"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:text="@string/rapid_scan_undo_last"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:strokeColor="?attr/colorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rapidScanLoading"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_scan_debug_status"
        android:elevation="22dp"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="?attr/colorSecondary" />

        <TextView
            android:id="@+id/rapidScanLoadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/rapid_scan_loading_ocr"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_scan_debug_status"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/experimentalScanDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/experimentalScanCrop"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#33000000"
                android:contentDescription="@string/experimental_scan_bottom_preview"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/experimentalScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="9"
                android:scrollbars="vertical"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hashScanBorderResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_scan_debug_status"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="?attr/colorSecondary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hashScanLanguageResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_scan_debug_status"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="?attr/colorSecondary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/hashScanResultsScroll"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/hashScanResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/rapidScanArtHashStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:textColor="#DDFFFFFF"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/experimentalScanCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@android:string/cancel"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/experimentalScanCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/experimental_scan_manual_capture"
                app:backgroundTint="?attr/colorSecondary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
