<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_arcane_edition_row"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="78dp"
        android:layout_marginEnd="10dp">
        <io.asv.mtgocr.ocrreader.RoundedCardImageView
            android:id="@+id/imgEditionThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/card_edition_image"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/imgFoilBadge"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:contentDescription="@string/foil_card_badge"
            android:src="@drawable/ic_foil_badge"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtEditionSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5D783"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEditionMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appGlassTextColor" />

        <TextView
            android:id="@+id/txtEditionPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <RadioButton
        android:id="@+id/radioOwnedEdition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorSecondary"
        android:contentDescription="@string/select_owned_edition" />

    <ImageButton
        android:id="@+id/btnRemoveEditionCopy"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_arcane_action"
        android:contentDescription="@string/remove_this_printing"
        android:padding="9dp"
        android:src="@drawable/ic_remove"
        app:tint="#FFF1BE" />

    <TextView
        android:id="@+id/txtEditionCopyCount"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/colorSecondary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnAddEditionCopy"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_arcane_action"
        android:contentDescription="@string/add_this_printing"
        android:padding="10dp"
        android:src="@drawable/ic_add"
        app:tint="#FFF1BE" />
</LinearLayout>
