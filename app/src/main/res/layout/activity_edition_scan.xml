<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <io.asv.mtgocr.ocrreader.ui.camera.CameraSourcePreview
        android:id="@+id/editionCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <io.asv.mtgocr.ocrreader.EditionSymbolGuideView
        android:id="@+id/editionScanLiveGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <io.asv.mtgocr.ocrreader.CardCropAdjustView
        android:id="@+id/editionCropCorrection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/edition_scan_crop_correction"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/bg_scan_debug_status"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/editionScanCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editionScanInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/edition_scan_align_card"
            android:textColor="#D6FF7F"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_scan_debug_status"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/editionScanDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/editionScanCrop"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#33000000"
                android:contentDescription="@string/edition_scan_evidence_preview"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/editionScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editionScanCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@android:string/cancel"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editionScanCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/edition_scan_take_photo"
                app:backgroundTint="?attr/colorSecondary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
