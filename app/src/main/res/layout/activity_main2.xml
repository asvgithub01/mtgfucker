                <TextView android:id="@+id/txtEditionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="?attr/appGlassTextColor" android:textSize="13sp" />
            </LinearLayout>
