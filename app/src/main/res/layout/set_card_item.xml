<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/txtSetCardPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold" />

    <io.asv.mtgocr.ocrreader.RoundedCardFrameLayout
        android:layout_width="match_parent"
        android:layout_height="210dp">
        <io.asv.mtgocr.ocrreader.RoundedCardImageView
            android:id="@+id/imgSetCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/card_image"
            android:scaleType="centerInside" />
        <ImageView
            android:id="@+id/imgFoilBadge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:contentDescription="@string/foil_card_badge"
            android:src="@drawable/ic_foil_badge"
            android:visibility="gone" />
    </io.asv.mtgocr.ocrreader.RoundedCardFrameLayout>

    <CheckBox
        android:id="@+id/checkSetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:minHeight="52dp" />
</LinearLayout>
