<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="106dp" >
    <LinearLayout
      android:id="@+id/lytViewHolder"
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <LinearLayout

        android:layout_width="0dp"
        android:layout_height="104dp"
        android:orientation="vertical"
        android:background="#fff"
        android:padding="12dp"
        android:layout_weight="1">

    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Disciple of the Vault"
        android:textSize="24sp"
        android:textStyle="normal|bold"
        android:textColor="#000"
       />
        <TextView
          android:id="@+id/txtPrice"
          android:textColor="#000"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="L:$0.10 M:$0.10 H:$0.10"/>
        <TextView
          android:id="@+id/txtGroups"
          android:textColor="#666"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:ellipsize="end"
          android:textSize="12sp" />
        </LinearLayout>

        <ImageView
          android:id="@+id/imgCard"
          android:layout_width="44dp"
          android:layout_height="69dp"
          android:layout_margin="5dp"
          android:layout_gravity="right"
          android:adjustViewBounds="false"
          android:foregroundGravity="right"
          android:scaleType="fitXY"
            />
        <TextView
          android:id="@+id/txtCardQuantity"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:layout_marginHorizontal="6dp"
          android:background="@drawable/bg_quantity_badge"
          android:gravity="center"
          android:minWidth="32dp"
          android:textColor="@color/mtg_gold"
          android:textSize="18sp"
          android:textStyle="bold" />
        <ImageButton
          android:id="@+id/btnOrganizeCard"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:layout_gravity="center_vertical"
          android:layout_marginEnd="6dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/organize_card"
          android:padding="5dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_groups" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:padding="7dp"
        android:background="#000"></RelativeLayout>
    <RelativeLayout
        android:background="#c00"
        android:layout_width="match_parent"
        android:layout_height="104dp">

        <TextView
            android:id="@+id/txtUndo"
            android:textStyle="bold"
            android:text="UNDO"
            android:textColor="#fff"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RelativeLayout>
</LinearLayout>
