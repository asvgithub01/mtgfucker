<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="1dp">

    <LinearLayout
        android:id="@+id/lytViewHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <io.asv.mtgocr.ocrreader.RoundedCardFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202020">

            <io.asv.mtgocr.ocrreader.RoundedCardImageView
                android:id="@+id/imgCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/card_image"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="6dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:background="#D9000000"
                android:paddingStart="7dp"
                android:paddingTop="4dp"
                android:paddingEnd="7dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="#DDFFFFFF"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btnCardDetails"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/view_card_details"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_info_details" />
                <ImageButton
                    android:id="@+id/btnCardGallery"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_card_gallery"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_gallery" />
                <ImageButton
                    android:id="@+id/btnOrganizeCard"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/organize_card"
                    android:padding="6dp"
                    android:src="@drawable/ic_groups" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCardQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="46dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_quantity_badge"
                android:gravity="center"
                android:minWidth="34dp"
                android:textColor="?attr/colorSecondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFoilBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="86dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/foil_card_badge"
                android:src="@drawable/ic_foil_badge"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#D9000000"
                android:orientation="vertical"
                android:padding="7dp">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#F1F1F1"
                    android:textSize="11sp" />
            </LinearLayout>
        </io.asv.mtgocr.ocrreader.RoundedCardFrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtUndo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#CC0000"
        android:gravity="center"
        android:text="UNDO"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
