<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="92dp" android:background="@color/mtg_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
    <CheckBox android:id="@+id/checkGroupCard" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/mtg_green" />
    <ImageView android:id="@+id/imgGroupCard" android:layout_width="48dp" android:layout_height="70dp" android:layout_marginEnd="12dp" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtGroupCardName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/mtg_ink" android:textSize="18sp" />
        <TextView android:id="@+id/txtGroupCardEdition" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/mtg_muted" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/txtGroupCardQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_quantity_badge" android:textColor="@color/mtg_gold" android:textSize="17sp" android:textStyle="bold" />
</LinearLayout>
