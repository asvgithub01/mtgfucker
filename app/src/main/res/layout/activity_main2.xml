        </LinearLayout>
        <ProgressBar android:id="@+id/editionProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/editionsRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fadeScrollbars="false" android:nestedScrollingEnabled="true" android:overScrollMode="always" android:paddingBottom="32dp" android:scrollbarSize="5dp" android:scrollbarStyle="insideInset" android:scrollbarThumbVertical="@drawable/scrollbar_thumb_gold" android:scrollbars="vertical" />
    </io.asv.mtgocr.ocrreader.ArcaneBottomSheetLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
