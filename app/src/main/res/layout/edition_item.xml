<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mtg_surface"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/imgEditionThumbnail"
        android:layout_width="56dp"
        android:layout_height="78dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/card_edition_image"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtEditionSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mtg_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEditionMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mtg_muted" />

        <TextView
            android:id="@+id/txtEditionPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mtg_ink"
            android:textStyle="bold" />
    </LinearLayout>

    <RadioButton
        android:id="@+id/radioOwnedEdition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/mtg_green"
        android:contentDescription="@string/select_owned_edition" />

    <ImageButton
        android:id="@+id/btnAddEditionCopy"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/add_this_printing"
        android:padding="10dp"
        android:src="@drawable/ic_add"
        android:tint="@color/mtg_green" />
</LinearLayout>
